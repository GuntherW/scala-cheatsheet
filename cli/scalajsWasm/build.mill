//| mvnDeps: ["com.lihaoyi::mill-contrib-twirllib:$MILL_VERSION"]

package build

import mill.*
import mill.scalalib.*
import mill.scalajslib.*
import mill.scalajslib.api.*
import mill.twirllib.*

trait AppScalaModule extends ScalaModule:
  def scalaVersion = "3.9.0"

trait AppScalaJSModule extends AppScalaModule, ScalaJSModule:
  def scalaJSVersion        = "1.22.0"
  def moduleKind            = ModuleKind.ESModule
  def moduleSplitStyle      = ModuleSplitStyle.FewestModules
  def esFeatures            = super.esFeatures().withESVersion(ESVersion.ES2022)
  def scalaJSUseWebAssembly = true

object `package` extends AppScalaModule, TwirlModule:
  def moduleDeps = Seq(shared.jvm)

  def twirlVersion               = "2.0.9"
  override def twirlScalaVersion = scalaVersion()

  override def generatedSources = Task:
    super.generatedSources() ++ Seq(compileTwirl().classes)

  def mvnDeps = Seq(
    mvn"com.softwaremill.sttp.tapir::tapir-netty-server-sync:1.13.28",
    mvn"com.softwaremill.sttp.tapir::tapir-json-upickle:1.13.28",
    mvn"com.softwaremill.sttp.tapir::tapir-swagger-ui-bundle:1.13.28",
    mvn"com.softwaremill.ox::core:1.0.5",
    mvn"org.playframework.twirl::twirl-api:${twirlVersion()}"
  )

  def resources = Task:
    val jsPath = client.fastLinkJS().dest.path
    os.makeDir.all(Task.dest / "webapp")
    for file <- os.list(jsPath) if os.isFile(file) do
      os.copy.over(file, Task.dest / "webapp" / file.last)
    super.resources() ++ Seq(PathRef(Task.dest))

  object shared extends Module:
    trait SharedModule extends AppScalaModule, PlatformScalaModule:
      def mvnDeps = Seq(
        mvn"com.lihaoyi::upickle::4.4.3"
      )

    object jvm extends SharedModule
    object js  extends SharedModule, AppScalaJSModule

  object client extends AppScalaJSModule:
    def moduleDeps = Seq(shared.js)
    def mvnDeps    = Seq(
      mvn"org.scala-js::scalajs-dom::2.8.1"
    )
