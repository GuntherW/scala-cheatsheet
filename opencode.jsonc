{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "filesystem": {
        "type": "local",
        "command": [
          "scala-cli",
          "run",
          "/home/gunther/projekte/scala/scala-cheatsheet/cli/mcp-filesystem",
          "--main-class",
          "filesystemMcpServerStdio"
        ],
        "disabled": false,
        "timeout": {
          "catalog": 120000,
          "execution": 120000
        }
      }
    }
  }
}
