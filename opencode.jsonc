{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": [
        "scala-cli",
        "run",
        "/home/gunther/projekte/scala/scala-cheatsheet/cli/mcp-filesystem",
        "--main-class",
        "filesystemMcpServerStdio"
      ],
      "enabled": true
    }
  },
  "experimental": {
    "mcp_timeout": 120000
  }
}
